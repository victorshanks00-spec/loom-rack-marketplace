<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Loom & Rack | Fashion Marketplace</title>

  <meta
    name="description"
    content="Discover clothing from different sellers on Loom & Rack."
  >

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      color: #111111;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button {
      cursor: pointer;
      border: none;
    }

    /* HEADER */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: white;
      border-bottom: 1px solid #eeeeee;
    }

    .navbar {
      max-width: 1400px;
      margin: auto;
      height: 75px;
      padding: 0 30px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      font-size: 14px;
      font-weight: 600;
    }

    .nav-links a:hover {
      text-decoration: underline;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .search {
      width: 220px;
      padding: 11px 14px;
      border: 1px solid #dddddd;
      border-radius: 4px;
      outline: none;
    }

    .icon-button {
      background: transparent;
      font-size: 20px;
    }

    /* HERO */

    .hero {
      min-height: 600px;

      display: flex;
      align-items: center;

      color: white;

      background:
        linear-gradient(
          rgba(0,0,0,.45),
          rgba(0,0,0,.45)
        ),
        url("https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=1800&q=85")
        center / cover;
    }

    .hero-content {
      max-width: 1400px;
      width: 100%;
      margin: auto;
      padding: 50px 30px;
    }

    .hero h1 {
      max-width: 700px;
      font-size: clamp(45px, 7vw, 82px);
      line-height: .95;
      margin-bottom: 25px;
    }

    .hero p {
      max-width: 600px;
      font-size: 19px;
      line-height: 1.6;
      margin-bottom: 30px;
    }

    .hero-buttons {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .button {
      padding: 15px 25px;
      font-weight: 700;
      border-radius: 3px;
    }

    .button-black {
      background: #111;
      color: white;
    }

    .button-white {
      background: white;
      color: #111;
    }

    /* SECTIONS */

    .section {
      max-width: 1400px;
      margin: auto;
      padding: 75px 30px;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .section-header h2 {
      font-size: 32px;
    }

    .view-all {
      font-size: 14px;
      font-weight: 700;
      text-decoration: underline;
    }

    /* CATEGORIES */

    .categories {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 15px;
    }

    .category {
      position: relative;
      height: 220px;
      overflow: hidden;
      background: #eeeeee;
    }

    .category img {
      width: 100%;
      height: 100%;
      object-fit: cover;

      transition: transform .3s;
    }

    .category:hover img {
      transform: scale(1.06);
    }

    .category-name {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;

      padding: 25px 12px 15px;

      color: white;
      font-weight: 700;

      background: linear-gradient(
        transparent,
        rgba(0,0,0,.8)
      );
    }

    /* PRODUCTS */

    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .product-image {
      height: 380px;
      position: relative;
      overflow: hidden;
      background: #f4f4f4;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .3s;
    }

    .product:hover .product-image img {
      transform: scale(1.04);
    }

    .favorite {
      position: absolute;
      top: 15px;
      right: 15px;

      width: 40px;
      height: 40px;

      border-radius: 50%;
      background: white;

      font-size: 20px;
    }

    .product-info {
      padding-top: 15px;
    }

    .product-name {
      font-weight: 700;
      margin-bottom: 7px;
    }

    .seller {
      color: #777;
      font-size: 13px;
      margin-bottom: 8px;
    }

    .rating {
      font-size: 13px;
      margin-bottom: 8px;
    }

    .price {
      font-size: 18px;
      font-weight: 800;
    }

    .add-cart {
      width: 100%;
      margin-top: 12px;
      padding: 12px;

      background: #111;
      color: white;

      font-weight: 700;
    }

    .add-cart:hover {
      background: #333;
    }

    /* SELLERS */

    .sellers {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .seller-card {
      border: 1px solid #eeeeee;
      padding: 30px;
      text-align: center;
    }

    .seller-photo {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 15px;
    }

    .seller-card h3 {
      margin-bottom: 7px;
    }

    .seller-card p {
      color: #777;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .seller-button {
      background: #111;
      color: white;
      padding: 11px 20px;
      font-weight: 700;
    }

    /* WHY */

    .why-section {
      background: #f7f7f7;
      max-width: none;
    }

    .why-inner {
      max-width: 1400px;
      margin: auto;
      padding: 75px 30px;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .feature {
      background: white;
      padding: 30px;
    }

    .feature-icon {
      font-size: 28px;
      margin-bottom: 15px;
    }

    .feature h3 {
      margin-bottom: 10px;
    }

    .feature p {
      color: #666;
      line-height: 1.5;
    }

    /* CTA */

    .cta {
      background: #111;
      color: white;
      text-align: center;
      padding: 90px 20px;
    }

    .cta h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .cta p {
      color: #ccc;
      margin-bottom: 30px;
    }

    /* FOOTER */

    footer {
      background: #111;
      color: white;
      border-top: 1px solid #333;
    }

    .footer {
      max-width: 1400px;
      margin: auto;

      padding: 50px 30px;

      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
    }

    .footer h3 {
      margin-bottom: 15px;
    }

    .footer p,
    .footer a {
      color: #aaa;
      font-size: 14px;
      line-height: 2;
    }

    /* MOBILE */

    @media(max-width: 1000px) {

      .nav-links {
        display: none;
      }

      .categories {
        grid-template-columns: repeat(3, 1fr);
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
      }

      .sellers,
      .features {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer {
        grid-template-columns: repeat(2, 1fr);
      }

    }

    @media(max-width: 600px) {

      .navbar {
        height: 65px;
        padding: 0 15px;
      }

      .logo {
        font-size: 19px;
      }

      .search {
        width: 110px;
      }

      .hero {
        min-height: 520px;
      }

      .hero-content {
        padding: 40px 15px;
      }

      .hero h1 {
        font-size: 48px;
      }

      .hero p {
        font-size: 16px;
      }

      .section {
        padding: 50px 15px;
      }

      .section-header h2 {
        font-size: 25px;
      }

      .categories {
        grid-template-columns: repeat(2, 1fr);
      }

      .category {
        height: 180px;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .product-image {
        height: 250px;
      }

      .sellers,
      .features,
      .footer {
        grid-template-columns: 1fr;
      }

      .cta h2 {
        font-size: 32px;
      }

    }
  </style>
</head>

