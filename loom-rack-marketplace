  <script>

    let cart = JSON.parse(
      localStorage.getItem("loomRackCart")
    ) || [];


    function addToCart(name, price) {

      const existing = cart.find(
        item => item.name === name
      );

      if (existing) {

        existing.quantity++;

      } else {

        cart.push({
          name: name,
          price: price,
          quantity: 1
        });

      }

      localStorage.setItem(
        "loomRackCart",
        JSON.stringify(cart)
      );

      alert(
        name + " has been added to your cart."
      );

    }


    function showCart() {

      const total = cart.reduce(
        (sum, item) =>
          sum + item.quantity,
        0
      );

      alert(
        "Cart: " +
        total +
        " item(s)"
      );

    }


    function showAccount() {

      alert(
        "Account\n\n" +
        "Customer Login\n" +
        "Seller Login\n" +
        "Admin Login"
      );

    }


    function favorite(button) {

      if (button.innerText === "♡") {

        button.innerText = "♥";

      } else {

        button.innerText = "♡";

      }

    }


    function goToShop() {

      document
        .getElementById("shop")
        .scrollIntoView({
          behavior: "smooth"
        });

    }


    function goToCategories() {

      document
        .getElementById("categories")
        .scrollIntoView({
          behavior: "smooth"
        });

    }


    document
      .getElementById("searchInput")
      .addEventListener(
        "keypress",
        function(event) {

          if (event.key === "Enter") {

            const search =
              this.value.trim();

            if (search) {

              alert(
                "Searching for: " +
                search
              );

            }

          }

        }
      );

  </script>

